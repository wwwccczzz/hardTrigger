--cpu Cortex-M3
".\keil_build\main.o"
".\keil_build\system_stm32f10x.o"
".\keil_build\startup_stm32f10x_hd.o"
--strict --scatter ".\keil_build\camera_hard_trigger.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\keil_build\camera_hard_trigger.map" -o .\keil_build\camera_hard_trigger.axf